#!/bin/bash

# Age-encrypted dotenv files in a git repo, one per project/env:
#   $SECRETS_DIR/<project>/<env>.env.age
#
# The age identity lives passphrase-encrypted outside the repo. `unlock`
# decrypts it into the kernel user keyring with a timeout, so the plain
# identity never touches disk and expires on its own.

set -euo pipefail

export PATH="$HOME/.local/share/mise/shims:$PATH"

REPO="${SECRETS_DIR:-$HOME/Work/secrets}"
IDENTITY="${SECRETS_IDENTITY:-$HOME/.config/secrets/identity.age}"
TTL="${SECRETS_TTL:-0}"
KEYNAME="secrets:identity"
RECIPIENTS="$REPO/.age-recipients"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"

die() { echo "secrets: $*" >&2; exit 1; }

# Private tmpfs scratch dir, removed on exit (also from inside a subshell).
scratch() {
  TMPD=$(mktemp -d -p "$RUNTIME")
  trap 'rm -rf "$TMPD"' EXIT
}

usage() {
  cat <<'EOF'
Usage: secrets <command> [args]

Setup
  init [--stdin]               create the identity (asks for a passphrase) and the repo
  backup-key [FILE]            create an offline backup key, print it (or write FILE), rekey
  rotate [--stdin]             replace the primary identity with a new one, rekey
  rekey                        re-encrypt every env to the current .age-recipients

Session
  unlock [--stdin]             cache the identity in the kernel keyring, for $SECRETS_TTL seconds
                               if set (0 or unset: until `lock` or logout)
  lock                         forget it now
  status [--json]

Data (<path> is project/env, e.g. primire/production)
  ls [--json]                  list envs
  keys <path> [--json]         list key names in an env
  index                        every env/key pair, as JSON
  get <path> <KEY>             print a value
  copy <path> <KEY> [--name|--line]
                               copy the value (or the key name, or the KEY=value line)
  set <path> <KEY> [VALUE]     set a value (prompts, or reads one line from stdin, if VALUE is omitted)
  rm <path> [KEY]              remove a key, or the whole env
  export <path>                print the env as dotenv
  run <path> -- <cmd...>       run a command with the env loaded

Git
  sync                         pull --rebase, then push

--stdin reads passphrases one per line from stdin instead of the terminal.
EOF
}

# --- identity / keyring ------------------------------------------------------

key_id() { keyctl search @u user "$KEYNAME" 2>/dev/null; }

identity() {
  local id
  id=$(key_id) || die "locked, run: secrets unlock"
  keyctl pipe "$id"
}

cache_identity() { # file
  keyctl padd user "$KEYNAME" @u <"$1" >/dev/null
  keyctl timeout "$(key_id)" "$TTL"
}

# age only reads passphrases from a terminal, so --stdin feeds it through a pty.
age_with_passphrase() { # input age-args...
  local input=$1; shift
  printf '%s' "$input" | SHELL=/bin/bash setsid script -qec "$(printf '%q ' age "$@")" /dev/null >/dev/null 2>&1
}

read_passphrase() { # use-stdin prompt -> stdout
  local pw
  if [[ $1 == 1 ]]; then
    IFS= read -r pw || true
  else
    read -rsp "$2: " pw </dev/tty; echo >&2
  fi
  [[ -n $pw ]] || die "empty passphrase"
  printf '%s' "$pw"
}

# Creates a passphrase-protected identity at $2, caches it, prints its public key.
new_identity() { # use-stdin out
  local pw confirm pub
  scratch
  pw=$(read_passphrase "$1" "New passphrase")
  if [[ $1 == 0 ]]; then
    confirm=$(read_passphrase 0 "Confirm passphrase")
    [[ $pw == "$confirm" ]] || die "passphrases don't match"
  fi
  age-keygen -o "$TMPD/key" 2>/dev/null
  age_with_passphrase "$pw"$'\n'"$pw"$'\n' -p -a -o "$TMPD/key.age" "$TMPD/key" || die "could not encrypt identity"
  mkdir -p "$(dirname "$2")"
  install -m 600 "$TMPD/key.age" "$2"
  pub=$(age-keygen -y "$TMPD/key")
  cache_identity "$TMPD/key"
  printf '%s\n' "$pub"
}

cmd_unlock() {
  [[ -f $IDENTITY ]] || die "no identity, run: secrets init"
  local pw
  scratch
  if [[ ${1:-} == --stdin ]]; then
    IFS= read -r pw || true
    age_with_passphrase "$pw"$'\n' -d -o "$TMPD/key" "$IDENTITY" || die "wrong passphrase"
  else
    age -d -o "$TMPD/key" "$IDENTITY" || die "wrong passphrase"
  fi
  cache_identity "$TMPD/key"
}

cmd_lock() {
  local id
  if id=$(key_id); then keyctl unlink "$id" @u >/dev/null; fi
}

cmd_status() {
  local initialized=false unlocked=false expires="" remote=false unpushed=0
  [[ -f $IDENTITY ]] && initialized=true
  if key_id >/dev/null; then
    unlocked=true
    expires=$(awk -v n="$KEYNAME:" '$9 == n { print $4 }' /proc/keys)
  fi
  if [[ -d $REPO/.git ]] && [[ -n $(git -C "$REPO" remote) ]]; then
    remote=true
    unpushed=$(git -C "$REPO" rev-list --count '@{u}..HEAD' 2>/dev/null \
      || git -C "$REPO" rev-list --count HEAD 2>/dev/null || echo 0)
  fi
  if [[ ${1:-} == --json ]]; then
    jq -cn --argjson i $initialized --argjson u $unlocked --arg e "$expires" \
      --argjson r $remote --argjson p "$unpushed" --arg repo "$REPO" \
      '{initialized:$i, unlocked:$u, expires:$e, remote:$r, unpushed:$p, repo:$repo}'
    return
  fi
  if ! $initialized; then echo "not initialized, run: secrets init"; return; fi
  if ! $unlocked; then echo "locked"
  elif [[ $expires == perm ]]; then echo "unlocked"
  else echo "unlocked (expires in $expires)"; fi
  if $remote && [[ $unpushed != 0 ]]; then echo "$unpushed unpushed commit(s), run: secrets sync"; fi
}

# --- envs ------------------------------------------------------------------------

check_path() {
  [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]] \
    || die "path must look like project/env, got: ${1:-<empty>}"
}

check_key() {
  [[ ${1:-} =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid key name: ${1:-<empty>}"
}

file_for() { echo "$REPO/$1.env.age"; }

require_env() {
  check_path "${1:-}"
  [[ -f $(file_for "$1") ]] || die "no such env: $1"
}

envs() {
  [[ -d $REPO ]] || return 0
  (cd "$REPO" && find . -path ./.git -prune -o -type f -name '*.env.age' -print) \
    | sed -e 's|^\./||' -e 's|\.env\.age$||' | sort
}

# Plaintext of an env, newline-terminated lines. Callers must use it as
# `x=$(plain p) || exit 1` so a failed decrypt can never be mistaken for an
# empty env and written back over the real one.
plain() { # path
  local key out
  key=$(identity) || exit 1
  out=$(age -d -i <(printf '%s\n' "$key") "$(file_for "$1")") || die "could not decrypt $1"
  [[ -n $out ]] && printf '%s\n' "$out"
  true
}

write_env() { # path, plaintext on stdin
  [[ -s $RECIPIENTS ]] || die "no recipients, run: secrets init"
  local file tmp
  file=$(file_for "$1")
  mkdir -p "$(dirname "$file")"
  tmp=$(mktemp "$file.XXXXXX")
  age -a -R "$RECIPIENTS" -o "$tmp" || { rm -f "$tmp"; die "encryption failed"; }
  mv "$tmp" "$file"
}

commit() { # message
  git -C "$REPO" add -A
  git -C "$REPO" diff --cached --quiet && return 0
  git -C "$REPO" commit -qm "$1"
  if [[ -n $(git -C "$REPO" remote) ]]; then
    setsid -f git -C "$REPO" push -qu origin HEAD >/dev/null 2>&1 </dev/null
  fi
}

lines_of() { # plaintext -> KEY=VALUE lines only
  local line
  while IFS= read -r line; do
    [[ $line == *=* ]] && printf '%s\n' "$line"
  done <<<"$1"
  true
}

# --- commands ----------------------------------------------------------------------

cmd_init() {
  [[ -f $IDENTITY ]] && die "identity already exists: $IDENTITY"
  local use_stdin=0 pub
  [[ ${1:-} == --stdin ]] && use_stdin=1
  pub=$(new_identity $use_stdin "$IDENTITY") || exit 1
  mkdir -p "$REPO"
  [[ -d $REPO/.git ]] || git -C "$REPO" init -q
  printf '# primary %s\n%s\n' "$(date +%F)" "$pub" >>"$RECIPIENTS"
  commit "chore: add primary recipient"
  echo "identity: $IDENTITY" >&2
  echo "public key: $pub" >&2
}

rekey_all() {
  local path text
  for path in $(envs); do
    text=$(plain "$path") || exit 1
    printf '%s' "$text"${text:+$'\n'} | write_env "$path"
  done
}

cmd_backup_key() {
  identity >/dev/null || exit 1
  local key pub
  key=$(age-keygen 2>/dev/null)
  pub=$(age-keygen -y <<<"$key")
  if [[ -n ${1:-} ]]; then
    (umask 077 && printf '%s\n' "$key" >"$1")
    echo "backup key written to $1, keep it offline and delete it from this machine" >&2
  else
    printf '%s\n' "$key"
    echo "^ backup key: print it or store it offline, it is not saved anywhere" >&2
  fi
  printf '# backup %s\n%s\n' "$(date +%F)" "$pub" >>"$RECIPIENTS"
  rekey_all
  commit "chore: add backup recipient"
}

cmd_rotate() {
  local use_stdin=0 old_key old_pub new_pub path text
  [[ ${1:-} == --stdin ]] && use_stdin=1
  old_key=$(identity) || exit 1
  old_pub=$(age-keygen -y <<<"$old_key")
  local -A texts=()
  for path in $(envs); do
    texts[$path]=$(plain "$path") || exit 1
  done
  new_pub=$(new_identity $use_stdin "$IDENTITY.new") || exit 1
  { grep -vxF -e "$old_pub" "$RECIPIENTS" | sed '/^# primary /d' || true
    printf '# primary %s\n%s\n' "$(date +%F)" "$new_pub"; } >"$RECIPIENTS.tmp"
  mv "$RECIPIENTS.tmp" "$RECIPIENTS"
  for path in "${!texts[@]}"; do
    text=${texts[$path]}
    printf '%s' "$text"${text:+$'\n'} | write_env "$path"
  done
  mv "$IDENTITY.new" "$IDENTITY"
  commit "chore: rotate primary recipient"
  echo "rotated, new public key: $new_pub" >&2
}

cmd_ls() {
  if [[ ${1:-} == --json ]]; then envs | jq -Rnc '[inputs]'; else envs; fi
}

cmd_keys() {
  require_env "${1:-}"
  local text
  text=$(plain "$1") || exit 1
  if [[ ${2:-} == --json ]]; then
    lines_of "$text" | sed 's/=.*//' | jq -Rnc '[inputs]'
  else
    lines_of "$text" | sed 's/=.*//'
  fi
}

cmd_index() {
  local path text
  identity >/dev/null || exit 1
  for path in $(envs); do
    text=$(plain "$path") || exit 1
    lines_of "$text" | sed 's/=.*//' | jq -Rc --arg e "$path" '{env:$e, key:.}'
  done | jq -sc .
}

value_of() { # path key
  local text line
  text=$(plain "$1") || exit 1
  while IFS= read -r line; do
    if [[ ${line%%=*} == "$2" ]]; then printf '%s' "${line#*=}"; return 0; fi
  done < <(lines_of "$text")
  die "no key $2 in $1"
}

cmd_get() {
  require_env "${1:-}"; check_key "${2:-}"
  local value
  value=$(value_of "$1" "$2") || exit 1
  printf '%s\n' "$value"
}

cmd_copy() {
  require_env "${1:-}"; check_key "${2:-}"
  local text
  case ${3:-} in
    --name) text=$2 ;;
    --line) text=$2=$(value_of "$1" "$2") || exit 1 ;;
    "") text=$(value_of "$1" "$2") || exit 1 ;;
    *) die "unknown copy option: $3" ;;
  esac
  # wl-copy stays around serving the paste; keep it off our stdio so callers
  # reading our output to EOF aren't held open.
  printf '%s' "$text" | wl-copy >/dev/null 2>&1
}

cmd_set() {
  check_path "${1:-}"; check_key "${2:-}"
  local path=$1 key=$2 value text="" line out="" replaced=0
  if [[ $# -ge 3 ]]; then
    value=$3
  elif [[ -t 0 ]]; then
    read -rsp "$key: " value </dev/tty; echo >&2
  else
    IFS= read -r value || true
  fi
  [[ $value != *$'\n'* ]] || die "multi-line values are not supported"
  if [[ -f $(file_for "$path") ]]; then
    text=$(plain "$path") || exit 1
  fi
  while IFS= read -r line; do
    if [[ ${line%%=*} == "$key" ]]; then
      [[ $replaced == 0 ]] && out+="$key=$value"$'\n'
      replaced=1
    else
      out+="$line"$'\n'
    fi
  done < <(lines_of "$text")
  [[ $replaced == 1 ]] || out+="$key=$value"$'\n'
  printf '%s' "$out" | write_env "$path"
  commit "update $path"
}

cmd_rm() {
  require_env "${1:-}"
  local path=$1 file text line out="" found=0
  file=$(file_for "$path")
  if [[ -z ${2:-} ]]; then
    rm "$file"
    rmdir "$(dirname "$file")" 2>/dev/null || true
    commit "remove $path"
    return
  fi
  check_key "$2"
  text=$(plain "$path") || exit 1
  while IFS= read -r line; do
    if [[ ${line%%=*} == "$2" ]]; then found=1; else out+="$line"$'\n'; fi
  done < <(lines_of "$text")
  [[ $found == 1 ]] || die "no key $2 in $path"
  printf '%s' "$out" | write_env "$path"
  commit "update $path"
}

cmd_export() {
  require_env "${1:-}"
  local text
  text=$(plain "$1") || exit 1
  lines_of "$text"
}

cmd_run() {
  require_env "${1:-}"
  local path=$1 text line; shift
  [[ ${1:-} == -- ]] && shift
  [[ $# -gt 0 ]] || die "usage: secrets run <path> -- <cmd...>"
  text=$(plain "$path") || exit 1
  while IFS= read -r line; do
    export "$line"
  done < <(lines_of "$text")
  exec "$@"
}

cmd_sync() {
  if git -C "$REPO" rev-parse -q --verify '@{u}' >/dev/null; then
    git -C "$REPO" pull --rebase -q
  fi
  git -C "$REPO" push -qu origin HEAD
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case $cmd in
  init) cmd_init "$@" ;;
  unlock) cmd_unlock "$@" ;;
  lock) cmd_lock ;;
  status) cmd_status "$@" ;;
  backup-key) cmd_backup_key "$@" ;;
  rotate) cmd_rotate "$@" ;;
  rekey) rekey_all; commit "chore: rekey" ;;
  ls) cmd_ls "$@" ;;
  keys) cmd_keys "$@" ;;
  index) cmd_index ;;
  get) cmd_get "$@" ;;
  copy) cmd_copy "$@" ;;
  set) cmd_set "$@" ;;
  rm) cmd_rm "$@" ;;
  export) cmd_export "$@" ;;
  run) cmd_run "$@" ;;
  sync) cmd_sync ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $cmd (see: secrets help)" ;;
esac
