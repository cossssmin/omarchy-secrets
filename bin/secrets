#!/bin/bash

# Age-encrypted dotenv files in a git repo, one per project/env:
#   $SECRETS_DIR/<project>/<env>.env.age
#
# The age identity lives passphrase-encrypted outside the repo. `unlock`
# decrypts it into the kernel user keyring with a timeout, so the plain
# identity never touches disk and expires on its own.
#
# age doesn't authenticate who encrypted a file, and the public key is in the
# repo, so anyone who can push could plant an env file that decrypts fine.
# Every env therefore starts with a `#mac=` line: an HMAC over its path and
# contents, keyed with a secret kept inside your identity. Files without a
# valid one are refused.

set -euo pipefail

# Optional config, as KEY=value lines (`secrets config` edits it). Anything
# already set in the environment wins over it.
CONFIG_KEYS="DIR|IDENTITY|TTL|SYNC|LOCK_ON_SCREEN_LOCK"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/secrets/config"
if [[ -f $CONFIG ]]; then
  while IFS='=' read -r name value; do
    [[ $name =~ ^SECRETS_($CONFIG_KEYS)$ && -z ${!name:-} ]] || continue
    value=${value%\"}; value=${value#\"}
    [[ $value == "~"* ]] && value=$HOME${value:1}
    printf -v "$name" '%s' "$value"
  done <"$CONFIG"
fi

REPO="${SECRETS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/secrets}"
IDENTITY="${SECRETS_IDENTITY:-$HOME/.config/secrets/identity.age}"
TTL="${SECRETS_TTL:-900}"
SYNC="${SECRETS_SYNC:-github}"
LOCK_ON_SCREEN_LOCK="${SECRETS_LOCK_ON_SCREEN_LOCK:-true}"
[[ $TTL =~ ^[0-9]+$ ]] || TTL=900
[[ $SYNC == local ]] || SYNC=github
[[ $LOCK_ON_SCREEN_LOCK == false ]] || LOCK_ON_SCREEN_LOCK=true
# One keyring entry per identity file, so separate identities don't collide.
KEYNAME="secrets:identity:$(printf '%s' "$IDENTITY" | sha256sum | cut -c1-12)"
RECIPIENTS="$REPO/.age-recipients"
# The recipients last approved on this machine. It lives in .git, so it's
# never pushed and someone with only write access to the remote can't change it.
TRUSTED="$REPO/.git/secrets-trusted-recipients"
# Present once every env in this clone carries a MAC; from then on a missing
# one means tampering rather than a repo from before integrity checks.
MACS_REQUIRED="$REPO/.git/secrets-macs-required"
PATH_RE='^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$'
KEY_RE='^[A-Za-z_][A-Za-z0-9_]*$'
MAC_LINE='# secrets-mac-key: '
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"

die() { echo "secrets: $*" >&2; exit 1; }

# Private tmpfs scratch dir, removed on exit (also from inside a subshell).
scratch() {
  TMPD=$(mktemp -d -p "$RUNTIME")
  trap 'rm -rf "$TMPD"' EXIT
}

usage() {
  cat <<'EOF'
Usage: secrets <command> [args]

Setup
  init [--stdin]               create the identity (asks for a passphrase) and the repo
  backup-key [FILE]            create an offline backup key, print it (or write FILE), rekey
  rotate [--stdin]             replace the primary identity with a new one, rekey
  rekey                        re-encrypt every env to the current .age-recipients

Session
  unlock [--stdin]             cache the identity in the kernel keyring for $SECRETS_TTL seconds
                               (default 900; 0 keeps it until `lock` or reboot)
  lock                         forget it now
  status [--json]

Config (~/.config/secrets/config)
  config                       print the settings, as JSON
  config set <name> <value>    dir <path>, ttl <seconds>, sync github|local,
                               lock-on-screen-lock true|false, remote <git url>
  trust                        approve the current .age-recipients after reviewing it

Data (<path> is project/env, e.g. acme-api/production)
  ls [--json]                  list envs
  keys <path> [--json]         list key names in an env
  index                        every env/key pair, as JSON
  get <path> <KEY>             print a value
  copy <path> <KEY> [--name|--line]
                               copy the value (or the key name, or the KEY=value line)
  set <path> <KEY> [VALUE]     set a value (prompts, or reads one line from stdin, if VALUE is omitted)
  rm <path> [KEY]              remove a key, or the whole env
  mv <path> <new-path>         rename an env (re-encrypts it, so it needs to be unlocked)
  export <path>                print the env as dotenv
  run <path> -- <cmd...>       run a command with the env loaded

Git
  sync                         pull --rebase, then push (unless sync is local)

--stdin reads passphrases one per line from stdin instead of the terminal.
EOF
}

# --- identity / keyring ------------------------------------------------------

key_id() { keyctl search @u user "$KEYNAME" 2>/dev/null; }

identity() {
  local id
  id=$(key_id) || die "locked, run: secrets unlock"
  keyctl pipe "$id"
}

# HMAC-SHA256 with a 32-byte hex key; message on stdin, hex digest on stdout.
# Plain bash + sha256sum, so the key never shows up in a process's argv.
hmac_sha256() {
  local key=$1 ipad="" opad="" i b inner
  for ((i = 0; i < 64; i++)); do
    b=0
    if ((i < 32)); then b=$((16#${key:i*2:2})); fi
    ipad+=$(printf '\\x%02x' $((b ^ 0x36)))
    opad+=$(printf '\\x%02x' $((b ^ 0x5c)))
  done
  inner=$({ printf '%b' "$ipad"; cat; } | sha256sum)
  { printf '%b' "$opad"; printf '%b' "$(sed 's/../\\x&/g' <<<"${inner:0:64}")"; } | sha256sum | cut -c1-64
}

new_mac_key() { head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

mac_key() {
  local key
  key=$(identity | sed -n "s/^$MAC_LINE\([0-9a-f]\{64\}\)\$/\1/p") || exit 1
  [[ -n $key ]] || die "your identity predates integrity checks, run: secrets unlock (it upgrades it)"
  printf '%s' "$key"
}

cache_identity() { # file
  keyctl padd user "$KEYNAME" @u <"$1" >/dev/null
  keyctl timeout "$(key_id)" "$TTL"
}

# age only reads passphrases from a terminal, so --stdin feeds it through a pty.
age_with_passphrase() { # input age-args...
  local input=$1; shift
  printf '%s' "$input" | SHELL=/bin/bash setsid script -qec "$(printf '%q ' age "$@")" /dev/null >/dev/null 2>&1
}

read_passphrase() { # use-stdin prompt -> stdout
  local pw
  if [[ $1 == 1 ]]; then
    IFS= read -r pw || true
  else
    read -rsp "$2: " pw </dev/tty; echo >&2
  fi
  [[ -n $pw ]] || die "empty passphrase"
  printf '%s' "$pw"
}

# Creates a passphrase-protected identity at $2, caches it, prints its public
# key. $3 carries an existing MAC key over (rotation); otherwise a new one.
new_identity() { # use-stdin out [mac-key]
  local pw confirm pub
  scratch
  pw=$(read_passphrase "$1" "New passphrase")
  if [[ $1 == 0 ]]; then
    confirm=$(read_passphrase 0 "Confirm passphrase")
    [[ $pw == "$confirm" ]] || die "passphrases don't match"
  fi
  age-keygen -o "$TMPD/key" 2>/dev/null
  printf '%s%s\n' "$MAC_LINE" "${3:-$(new_mac_key)}" >>"$TMPD/key"
  age_with_passphrase "$pw"$'\n'"$pw"$'\n' -p -a -o "$TMPD/key.age" "$TMPD/key" || die "could not encrypt identity"
  mkdir -p "$(dirname "$2")"
  install -m 600 "$TMPD/key.age" "$2"
  pub=$(age-keygen -y "$TMPD/key")
  cache_identity "$TMPD/key"
  printf '%s\n' "$pub"
}

cmd_unlock() {
  [[ -f $IDENTITY ]] || die "no identity, run: secrets init"
  local use_stdin=0 pw
  [[ ${1:-} == --stdin ]] && use_stdin=1
  scratch
  pw=$(read_passphrase $use_stdin "Passphrase") || exit 1
  age_with_passphrase "$pw"$'\n' -d -o "$TMPD/key" "$IDENTITY" || die "wrong passphrase"
  # Identities from before integrity checks get a MAC key added, re-encrypted
  # with the same passphrase, and only swapped in once the result opens.
  if ! grep -q "^$MAC_LINE" "$TMPD/key"; then
    printf '%s%s\n' "$MAC_LINE" "$(new_mac_key)" >>"$TMPD/key"
    age_with_passphrase "$pw"$'\n'"$pw"$'\n' -p -a -o "$TMPD/key.age" "$TMPD/key" || die "could not upgrade identity"
    age_with_passphrase "$pw"$'\n' -d -o "$TMPD/check" "$TMPD/key.age" && cmp -s "$TMPD/check" "$TMPD/key" \
      || die "could not upgrade identity"
    install -m 600 "$TMPD/key.age" "$IDENTITY.new"
    mv "$IDENTITY.new" "$IDENTITY"
  fi
  cache_identity "$TMPD/key"
}

cmd_lock() {
  local id
  if id=$(key_id); then keyctl unlink "$id" @u >/dev/null; fi
  # The single shared entry older versions used.
  if id=$(keyctl search @u user secrets:identity 2>/dev/null); then keyctl unlink "$id" @u >/dev/null; fi
}

cmd_status() {
  local initialized=false unlocked=false expires="" remote=false unpushed=0 trusted=true screen_locked=false
  [[ -f $IDENTITY ]] && initialized=true
  if key_id >/dev/null; then
    unlocked=true
    expires=$(awk -v n="$KEYNAME:" '$9 == n { print $4 }' /proc/keys)
  fi
  if has_remote; then
    remote=true
    unpushed=$(git -C "$REPO" rev-list --count '@{u}..HEAD' 2>/dev/null \
      || git -C "$REPO" rev-list --count HEAD 2>/dev/null || echo 0)
  fi
  [[ -z $(recipient_changes) ]] || trusted=false
  if command -v omarchy-hyprland-session-locked >/dev/null && omarchy-hyprland-session-locked; then
    screen_locked=true
  fi
  if [[ ${1:-} == --json ]]; then
    jq -cn --argjson i $initialized --argjson u $unlocked --arg e "$expires" \
      --argjson r $remote --argjson p "$unpushed" --arg repo "$REPO" \
      --argjson t $trusted --argjson sl $screen_locked --argjson lsl "$LOCK_ON_SCREEN_LOCK" \
      '{initialized:$i, unlocked:$u, expires:$e, remote:$r, unpushed:$p, repo:$repo,
        trusted:$t, screenLocked:$sl, lockOnScreenLock:$lsl}'
    return
  fi
  if ! $initialized; then echo "not initialized, run: secrets init"; return; fi
  if ! $unlocked; then echo "locked"
  elif [[ $expires == perm ]]; then echo "unlocked"
  else echo "unlocked (expires in $expires)"; fi
  if $remote && [[ $unpushed != 0 ]]; then echo "$unpushed unpushed commit(s), run: secrets sync"; fi
  if ! $trusted; then echo ".age-recipients changed since you last trusted it, review it and run: secrets trust"; fi
}

# --- config ------------------------------------------------------------------------

tilde() { [[ $1 == "$HOME"* ]] && printf '~%s' "${1#"$HOME"}" || printf '%s' "$1"; }

remote_url() { git -C "$REPO" remote get-url origin 2>/dev/null || true; }

has_remote() { [[ $SYNC == github && -d $REPO/.git && -n $(remote_url) ]]; }

cmd_config() {
  if [[ ${1:-} == set ]]; then shift; config_set "$@"; return; fi
  jq -cn --arg d "$(tilde "$REPO")" --argjson t "$TTL" --arg s "$SYNC" \
    --argjson l "$LOCK_ON_SCREEN_LOCK" --arg r "$(remote_url)" \
    '{dir:$d, ttl:$t, sync:$s, lockOnScreenLock:$l, remote:$r}'
}

write_config() { # NAME value
  mkdir -p "$(dirname "$CONFIG")"
  local tmp
  tmp=$(mktemp "$CONFIG.XXXXXX")
  { [[ -f $CONFIG ]] && grep -v "^$1=" "$CONFIG"; printf '%s="%s"\n' "$1" "$2"; } >"$tmp" || true
  mv "$tmp" "$CONFIG"
}

config_set() { # name value
  local name=${1:-} value=${2-}
  [[ $value != *[$'\n'\"]* ]] || die "values can't contain newlines or quotes"
  case $name in
    dir)
      [[ -n $value ]] || die "dir can't be empty"
      [[ $value == "~"* ]] && value=$HOME${value:1}
      use_repo "$value"
      write_config SECRETS_DIR "$(tilde "$value")" ;;
    ttl)
      [[ $value =~ ^[0-9]+$ ]] || die "ttl must be a number of seconds"
      write_config SECRETS_TTL "$value"
      # Apply it to the current unlock too.
      if key_id >/dev/null; then keyctl timeout "$(key_id)" "$value"; fi ;;
    sync)
      [[ $value == github || $value == local ]] || die "sync must be github or local"
      write_config SECRETS_SYNC "$value" ;;
    lock-on-screen-lock)
      [[ $value == true || $value == false ]] || die "lock-on-screen-lock must be true or false"
      write_config SECRETS_LOCK_ON_SCREEN_LOCK "$value" ;;
    remote)
      [[ -d $REPO/.git ]] || die "no repo yet at $(tilde "$REPO")"
      # Leading dashes would reach git as options; plain URLs and paths only.
      [[ -z $value || $value =~ ^(git@|ssh://|https://|file://|/)[^[:space:]]+$ ]] \
        || die "remote must be a git@, ssh://, https:// or file:// URL"
      if [[ -z $value ]]; then
        git -C "$REPO" remote remove origin 2>/dev/null || true
      elif [[ -n $(remote_url) ]]; then
        git -C "$REPO" remote set-url origin "$value"
      else
        git -C "$REPO" remote add origin "$value"
      fi ;;
    *) die "unknown setting: $name (dir, ttl, sync, lock-on-screen-lock, remote)" ;;
  esac
}

# Points at an existing secrets repo, or starts a new one in an empty folder.
use_repo() { # path
  [[ -f $1/.age-recipients ]] && return 0
  if [[ -d $1 && -n $(ls -A "$1") ]]; then
    die "$(tilde "$1") isn't empty and isn't a secrets repo"
  fi
  local pub
  pub=$(identity | age-keygen -y) || die "unlock first, a new repo needs your public key"
  mkdir -p "$1"
  git -C "$1" init -q
  printf '# primary %s\n%s\n' "$(date +%F)" "$pub" >"$1/.age-recipients"
  REPO=$1; RECIPIENTS="$REPO/.age-recipients"; TRUSTED="$REPO/.git/secrets-trusted-recipients"
  trust_recipients
  commit "chore: add primary recipient"
}

# --- recipients guard ------------------------------------------------------------
#
# Everything is encrypted to every key in .age-recipients, so whoever can push a
# line into it would be able to read everything written afterwards. Before
# encrypting, the file must match what was last approved on this machine.

current_recipients() { grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$RECIPIENTS" | sort -u; }

trust_recipients() { current_recipients >"$TRUSTED"; }

# Prints "+ key" / "- key" lines for unapproved changes, nothing if none.
recipient_changes() {
  [[ -f $RECIPIENTS && -d $REPO/.git ]] || return 0
  [[ -f $TRUSTED ]] || return 0
  diff "$TRUSTED" <(current_recipients) | sed -n -e 's/^> /+ /p' -e 's/^< /- /p' || true
}

check_recipients() {
  [[ -d $REPO/.git ]] || return 0
  # First use in this clone: trust it only if it lists nothing but your key.
  if [[ ! -f $TRUSTED ]]; then
    local mine
    mine=$(identity | age-keygen -y) || exit 1
    [[ $(current_recipients) == "$mine" ]] \
      || die ".age-recipients lists keys besides this identity's (your backup key shows up here too), refusing to encrypt until you approve them:
$(current_recipients | grep -vxF "$mine" | sed 's/^/+ /')
Review it (git log -p .age-recipients), then run: secrets trust"
    trust_recipients
    return 0
  fi
  local changes
  changes=$(recipient_changes)
  [[ -z $changes ]] && return 0
  die ".age-recipients changed since you last trusted it, refusing to encrypt:
$changes
Review it (git log -p .age-recipients), then run: secrets trust"
}

cmd_trust() {
  [[ -f $RECIPIENTS ]] || die "no .age-recipients in $(tilde "$REPO")"
  local changes
  changes=$(recipient_changes)
  if [[ -n $changes ]]; then printf '%s\n' "$changes"; fi
  trust_recipients
  echo "trusted $(current_recipients | wc -l) recipient(s)" >&2
}

# --- envs ------------------------------------------------------------------------

check_path() {
  [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]] \
    || die "path must look like project/env, got: ${1:-<empty>}"
}

check_key() {
  [[ ${1:-} =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid key name: ${1:-<empty>}"
}

file_for() { echo "$REPO/$1.env.age"; }

require_env() {
  check_path "${1:-}"
  [[ -f $(file_for "$1") ]] || die "no such env: $1"
}

envs() {
  [[ -d $REPO ]] || return 0
  (cd "$REPO" && find . -path ./.git -prune -o -type f -name '*.env.age' -print) \
    | sed -e 's|^\./||' -e 's|\.env\.age$||' | grep -E "$PATH_RE" | grep -vF '..' | sort || true
}

# Plaintext of an env, newline-terminated lines. Callers must use it as
# `x=$(plain p) || exit 1` so a failed decrypt can never be mistaken for an
# empty env and written back over the real one.
plain() { # path
  ensure_macs
  local out first body="" key
  out=$(decrypt_raw "$1") || exit 1
  if [[ $out == "#mac="* ]]; then
    first=${out%%$'\n'*}
    [[ $out == *$'\n'* ]] && body=${out#*$'\n'}
    key=$(mac_key) || exit 1
    [[ ${first#\#mac=} == "$(env_mac "$key" "$1" "$body")" ]] \
      || die "integrity check failed for $1: it wasn't written with your key, so it may have been tampered with (see git log -p $1.env.age)"
  elif [[ ${SCANNING:-0} == 1 ]]; then
    body=$out
  else
    die "integrity check failed for $1: it has no MAC, so it may have been tampered with (see git log -p $1.env.age)"
  fi
  [[ -n $body ]] && printf '%s\n' "$body"
  true
}

decrypt_raw() { # path
  local key
  key=$(identity) || exit 1
  age -d -i <(printf '%s\n' "$key") "$(file_for "$1")" || die "could not decrypt $1"
}

env_mac() { # key path body
  printf '%s\n%s' "$2" "$3" | hmac_sha256 "$1"
}

# Makes sure this clone requires MACs: if any env has one, they all must. A
# repo from before integrity checks (none have one) is upgraded in place.
ensure_macs() {
  [[ -d $REPO/.git && ! -f $MACS_REQUIRED && ${SCANNING:-0} != 1 ]] || return 0
  SCANNING=1
  local path text found=0 legacy=()
  for path in $(envs); do
    text=$(decrypt_raw "$path") || exit 1
    if [[ $text == "#mac="* ]]; then found=1; else legacy+=("$path"); fi
  done
  if [[ $found == 0 && ${#legacy[@]} -gt 0 ]]; then
    for path in "${legacy[@]}"; do
      text=$(plain "$path") || exit 1
      printf '%s' "$text" | write_env "$path"
    done
    : >"$MACS_REQUIRED"
    commit "chore: add integrity checks"
  else
    : >"$MACS_REQUIRED"
  fi
  SCANNING=0
}

write_env() { # path, plaintext on stdin
  [[ -s $RECIPIENTS ]] || die "no recipients, run: secrets init"
  check_recipients
  ensure_macs
  local file tmp body key mac
  key=$(mac_key) || exit 1
  # $(cat) drops trailing newlines, which is the same form plain() checks.
  body=$(cat)
  mac=$(env_mac "$key" "$1" "$body")
  file=$(file_for "$1")
  mkdir -p "$(dirname "$file")"
  tmp=$(mktemp "$file.XXXXXX")
  { printf '#mac=%s\n' "$mac"; [[ -n $body ]] && printf '%s\n' "$body"; true; } \
    | age -a -R "$RECIPIENTS" -o "$tmp" || { rm -f "$tmp"; die "encryption failed"; }
  mv "$tmp" "$file"
}

# Only managed files: a stray plaintext .env dropped in the folder stays out.
commit() { # message
  git -C "$REPO" add -A -- '*.env.age' .age-recipients
  git -C "$REPO" diff --cached --quiet && return 0
  git -C "$REPO" commit -qm "$1"
  if has_remote; then
    setsid -f git -C "$REPO" push -qu origin HEAD >/dev/null 2>&1 </dev/null
  fi
}

lines_of() { # plaintext -> KEY=VALUE lines only, with valid key names
  local line
  while IFS= read -r line; do
    [[ $line == *=* && ${line%%=*} =~ $KEY_RE ]] && printf '%s\n' "$line"
  done <<<"$1"
  true
}

# --- commands ----------------------------------------------------------------------

cmd_init() {
  [[ -f $IDENTITY ]] && die "identity already exists: $IDENTITY"
  local use_stdin=0 pub
  [[ ${1:-} == --stdin ]] && use_stdin=1
  pub=$(new_identity $use_stdin "$IDENTITY") || exit 1
  mkdir -p "$REPO"
  [[ -d $REPO/.git ]] || git -C "$REPO" init -q
  printf '# primary %s\n%s\n' "$(date +%F)" "$pub" >>"$RECIPIENTS"
  trust_recipients
  commit "chore: add primary recipient"
  echo "identity: $IDENTITY" >&2
  echo "public key: $pub" >&2
}

rekey_all() {
  local path text
  for path in $(envs); do
    text=$(plain "$path") || exit 1
    printf '%s' "$text"${text:+$'\n'} | write_env "$path"
  done
}

cmd_backup_key() {
  identity >/dev/null || exit 1
  local key pub
  key=$(age-keygen 2>/dev/null)$'\n'"$MAC_LINE$(mac_key)" || exit 1
  pub=$(age-keygen -y <<<"$key")
  if [[ -n ${1:-} ]]; then
    (umask 077 && printf '%s\n' "$key" >"$1")
    echo "backup key written to $1, keep it offline and delete it from this machine" >&2
  else
    printf '%s\n' "$key"
    echo "^ backup key: print it or store it offline, it is not saved anywhere" >&2
  fi
  check_recipients
  printf '# backup %s\n%s\n' "$(date +%F)" "$pub" >>"$RECIPIENTS"
  trust_recipients
  rekey_all
  commit "chore: add backup recipient"
}

cmd_rotate() {
  local use_stdin=0 old_key old_pub new_pub path text
  [[ ${1:-} == --stdin ]] && use_stdin=1
  old_key=$(identity) || exit 1
  old_pub=$(age-keygen -y <<<"$old_key")
  local mac; mac=$(mac_key) || exit 1
  check_recipients
  local -A texts=()
  for path in $(envs); do
    texts[$path]=$(plain "$path") || exit 1
  done
  new_pub=$(new_identity $use_stdin "$IDENTITY.new" "$mac") || exit 1
  { grep -vxF -e "$old_pub" "$RECIPIENTS" | sed '/^# primary /d' || true
    printf '# primary %s\n%s\n' "$(date +%F)" "$new_pub"; } >"$RECIPIENTS.tmp"
  mv "$RECIPIENTS.tmp" "$RECIPIENTS"
  trust_recipients
  for path in "${!texts[@]}"; do
    text=${texts[$path]}
    printf '%s' "$text"${text:+$'\n'} | write_env "$path"
  done
  mv "$IDENTITY.new" "$IDENTITY"
  commit "chore: rotate primary recipient"
  echo "rotated, new public key: $new_pub" >&2
}

cmd_ls() {
  if [[ ${1:-} == --json ]]; then envs | jq -Rnc '[inputs]'; else envs; fi
}

cmd_keys() {
  require_env "${1:-}"
  local text
  text=$(plain "$1") || exit 1
  if [[ ${2:-} == --json ]]; then
    lines_of "$text" | sed 's/=.*//' | jq -Rnc '[inputs]'
  else
    lines_of "$text" | sed 's/=.*//'
  fi
}

cmd_index() {
  local path text
  identity >/dev/null || exit 1
  for path in $(envs); do
    text=$(plain "$path") || exit 1
    lines_of "$text" | sed 's/=.*//' | jq -Rc --arg e "$path" '{env:$e, key:.}'
  done | jq -sc .
}

value_of() { # path key
  local text line
  text=$(plain "$1") || exit 1
  while IFS= read -r line; do
    if [[ ${line%%=*} == "$2" ]]; then printf '%s' "${line#*=}"; return 0; fi
  done < <(lines_of "$text")
  die "no key $2 in $1"
}

cmd_get() {
  require_env "${1:-}"; check_key "${2:-}"
  local value
  value=$(value_of "$1" "$2") || exit 1
  printf '%s\n' "$value"
}

cmd_copy() {
  require_env "${1:-}"; check_key "${2:-}"
  local text
  case ${3:-} in
    --name) text=$2 ;;
    --line) text=$2=$(value_of "$1" "$2") || exit 1 ;;
    "") text=$(value_of "$1" "$2") || exit 1 ;;
    *) die "unknown copy option: $3" ;;
  esac
  # wl-copy stays around serving the paste; keep it off our stdio so callers
  # reading our output to EOF aren't held open.
  printf '%s' "$text" | wl-copy >/dev/null 2>&1
}

cmd_set() {
  check_path "${1:-}"; check_key "${2:-}"
  local path=$1 key=$2 value text="" line out="" replaced=0
  if [[ $# -ge 3 ]]; then
    value=$3
  elif [[ -t 0 ]]; then
    read -rsp "$key: " value </dev/tty; echo >&2
  else
    IFS= read -r value || true
  fi
  [[ $value != *$'\n'* ]] || die "multi-line values are not supported"
  if [[ -f $(file_for "$path") ]]; then
    text=$(plain "$path") || exit 1
  fi
  while IFS= read -r line; do
    if [[ ${line%%=*} == "$key" ]]; then
      [[ $replaced == 0 ]] && out+="$key=$value"$'\n'
      replaced=1
    else
      out+="$line"$'\n'
    fi
  done < <(lines_of "$text")
  [[ $replaced == 1 ]] || out+="$key=$value"$'\n'
  printf '%s' "$out" | write_env "$path"
  commit "update $path"
}

cmd_rm() {
  require_env "${1:-}"
  local path=$1 file text line out="" found=0
  file=$(file_for "$path")
  if [[ -z ${2:-} ]]; then
    rm "$file"
    rmdir "$(dirname "$file")" 2>/dev/null || true
    commit "remove $path"
    return
  fi
  check_key "$2"
  text=$(plain "$path") || exit 1
  while IFS= read -r line; do
    if [[ ${line%%=*} == "$2" ]]; then found=1; else out+="$line"$'\n'; fi
  done < <(lines_of "$text")
  [[ $found == 1 ]] || die "no key $2 in $path"
  printf '%s' "$out" | write_env "$path"
  commit "update $path"
}

# Re-encrypted rather than moved: the MAC covers the path, so a file can't be
# passed off as another env.
cmd_mv() {
  require_env "${1:-}"; check_path "${2:-}"
  [[ $1 != "$2" ]] || return 0
  local from text
  from=$(file_for "$1")
  [[ ! -e $(file_for "$2") ]] || die "env already exists: $2"
  text=$(plain "$1") || exit 1
  printf '%s' "$text" | write_env "$2"
  rm "$from"
  rmdir "$(dirname "$from")" 2>/dev/null || true
  commit "rename $1 to $2"
}

cmd_export() {
  require_env "${1:-}"
  local text
  text=$(plain "$1") || exit 1
  lines_of "$text"
}

cmd_run() {
  require_env "${1:-}"
  local path=$1 text line; shift
  [[ ${1:-} == -- ]] && shift
  [[ $# -gt 0 ]] || die "usage: secrets run <path> -- <cmd...>"
  text=$(plain "$path") || exit 1
  while IFS= read -r line; do
    export "$line"
  done < <(lines_of "$text")
  exec "$@"
}

cmd_sync() {
  [[ $SYNC == github ]] || die "sync is set to local only"
  [[ -n $(remote_url) ]] || die "no remote set, add one with: secrets config set remote <git url>"
  if git -C "$REPO" rev-parse -q --verify '@{u}' >/dev/null; then
    git -C "$REPO" pull --rebase -q
  fi
  git -C "$REPO" push -qu origin HEAD
  # A pull can bring in recipients nobody approved here; say so right away.
  check_recipients
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case $cmd in
  init) cmd_init "$@" ;;
  unlock) cmd_unlock "$@" ;;
  lock) cmd_lock ;;
  status) cmd_status "$@" ;;
  config) cmd_config "$@" ;;
  trust) cmd_trust ;;
  backup-key) cmd_backup_key "$@" ;;
  rotate) cmd_rotate "$@" ;;
  rekey) rekey_all; commit "chore: rekey" ;;
  ls) cmd_ls "$@" ;;
  keys) cmd_keys "$@" ;;
  index) cmd_index ;;
  get) cmd_get "$@" ;;
  copy) cmd_copy "$@" ;;
  set) cmd_set "$@" ;;
  rm) cmd_rm "$@" ;;
  mv) cmd_mv "$@" ;;
  export) cmd_export "$@" ;;
  run) cmd_run "$@" ;;
  sync) cmd_sync ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $cmd (see: secrets help)" ;;
esac
